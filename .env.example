# Hackathon/demo path uses live adaptive roles + local DVAA.
MODEL_MODE=live
# Leave at 0 for demos. Tests may set this to 1.
COUNTERFORGE_ALLOW_SIMULATION=0
OPENROUTER_API_KEY=
ATTACKER_MODEL=z-ai/glm-5.3-flash
ATTACKER_BASE_URL=https://openrouter.ai/api/v1
ATTACKER_API_KEY=
DEFENDER_MODEL=z-ai/glm-5.3-flash
DEFENDER_BASE_URL=https://openrouter.ai/api/v1
DEFENDER_API_KEY=
ADAPTIVE_ATTACK_ROUNDS=2
TARGET_BASE_URL=
TARGET_MODEL=
CANARY_COLLECTOR_URL=http://127.0.0.1:65500
CANARY_EXFIL_URL=http://canary:65500/api/canary/exfil-test
ALERT_MODE=simulated
# Set ALERT_MODE=twilio_voice to enable approved outbound calls.
TWILIO_ACCOUNT_SID=
# Preferred authentication: an API Key SID (SK...) and its one-time secret.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Local fallback when an API key is not configured.
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBER=
ALERT_TIMEOUT_SECONDS=10

# Place a voice call automatically when an attack-lab run breaches the target
AUTO_PAGE_ON_BREACH=true
BREACH_PAGE_COOLDOWN_SECONDS=600
